# ============================================================
# DeligenX Platform - Root .gitignore
# ============================================================

# ── Secrets & Credentials (NEVER commit these) ──────────────
.env
.env.*
!.env.example
deligenx.json
*.pem
*.key

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.Python

# ── Generated Output & Runtime Data ─────────────────────────
output/
logs/
temp/
.cache/

# ── Frontend (handled by frontend/.gitignore too) ───────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts

# ── New Frontend (build artifacts) ──────────────────────────
new-frontend/node_modules/
new-frontend/.next/
new-frontend/.vercel
new-frontend/next-env.d.ts

# ── Old Frontend Backup ─────────────────────────────────────
frontend-old/

# ── Docker Volumes & Runtime ────────────────────────────────
data/certbot/
postgres_data/
redis_data/

# ── IDE & OS ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Misc dev/test files ─────────────────────────────────────
rows.txt
test.py
working.md
*.log

.agents/
Technical_Report.md
agents_working.md
data/cache/ticker_lookups/JPM_phase1.json
docs/
new-frontend/