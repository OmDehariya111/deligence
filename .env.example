# ============================================================
# DeligenX Platform — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit the real .env file to Git.
# ============================================================

# ── LLM Providers ───────────────────────────────────────────
# Groq — free tier available at https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE

# ── Data Providers ──────────────────────────────────────────
# NewsAPI — https://newsapi.org (free tier: 100 requests/day)
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE

# FRED (Federal Reserve) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=YOUR_FRED_API_KEY_HERE

# ── GCP Vertex AI ───────────────────────────────────────────
# Project ID from Google Cloud Console
VERTEX_AI_PROJECT="your-gcp-project-id"

# Region — keep us-central1 unless you have a reason to change
VERTEX_AI_LOCATION="us-central1"

# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your-service-account-key.json"

# LLM model names used by the pipeline (via litellm)
LLM_MODEL_NAME_TIER1="vertex_ai/gemini-2.5-flash"
LLM_MODEL_NAME_TIER2="vertex_ai/gemini-2.5-pro"

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (platform users, jobs, payments)
DATABASE_URL="postgresql://deligenx:CHANGE_THIS_PASSWORD@localhost:5432/deligenxdb"

# Redis connection string (Celery broker + API cache)
REDIS_URL="redis://localhost:6379/0"

# ── Authentication ──────────────────────────────────────────
# JWT secret — generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=GENERATE_A_RANDOM_64_CHAR_HEX_STRING

# Environment flag — controls cookie security, CORS, etc.
# Set to "production" on deployed servers
ENVIRONMENT=development

# ── Payments (Stripe) ──────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
# Leave empty to use mock payment mode (credits granted instantly)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Email Notifications (Resend) ───────────────────────────
# Get API key from https://resend.com
# Set to "re_123456789" to skip sending emails
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Frontend URL (used in email links) ─────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS (comma-separated origins allowed to call the API) ─
CORS_ORIGINS=http://localhost:3000
