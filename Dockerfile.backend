FROM python:3.12-slim

WORKDIR /app

# Install system dependencies needed by:
# - libpq-dev: psycopg2 (PostgreSQL driver)
# - build-essential: C extensions (chromadb, sentence-transformers)
# - curl: healthchecks
# - libglib2.0-0, libnss3, etc.: Playwright Chromium (PDF export)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    # Playwright Chromium dependencies
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright Chromium browser (for PDF export)
RUN playwright install chromium

# Copy source code (respects .dockerignore)
COPY . .

# Set the GCP credentials path inside the container
ENV GOOGLE_APPLICATION_CREDENTIALS=/app/deligenx.json

# Expose port
EXPOSE 8000

# Command to run (overridden in compose for celery worker)
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
